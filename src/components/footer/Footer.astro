---
import { SITE, NAV, LINKS, has } from '@data/site';

const year = new Date().getFullYear();
const socials = [
  { label: 'GitHub', url: LINKS.github },
  { label: 'LinkedIn', url: LINKS.linkedin },
  { label: 'Twitter', url: LINKS.twitter },
  { label: 'Résumé', url: LINKS.resume, isDownload: true },
].filter((s) => has(s.url));
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <a href="#top" class="footer__logo" aria-label={`${SITE.name} — back to top`}>
        {SITE.shortName}<span class="footer__dot" aria-hidden="true">.</span>
      </a>
      <p class="footer__tag">{SITE.tagline}</p>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      <ul>
        {NAV.map((item) => <li><a class="link" href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer__contact">
      <a class="link footer__email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      {
        socials.length > 0 && (
          <ul class="footer__socials">
            {socials.map((s) => (
              <li>
                <a
                  class="link"
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  download={s.isDownload ? 'Kutub_Islam_Frontend_Engineer_Resume.pdf' : undefined}
                >
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  <div class="wrap footer__base">
    <span>© {year} {SITE.name}</span>
    <a href="#top" class="link footer__top">Back to top ↑</a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    padding-block: clamp(3rem, 7vh, 5rem);
  }
  .footer__inner {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  .footer__logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.03em;
  }
  .footer__dot {
    color: var(--color-accent);
  }
  .footer__tag {
    margin-top: 0.8rem;
    max-width: 32ch;
    color: var(--color-fg-dim);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .footer__nav ul,
  .footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
  }
  .footer__nav ul {
    flex-direction: column;
    gap: 0.7rem;
  }
  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    align-items: flex-start;
  }
  .footer__email {
    font-size: 1.05rem;
    color: var(--color-fg);
  }
  .footer__socials {
    font-size: 0.9rem;
    color: var(--color-fg-dim);
  }
  .footer__base {
    margin-top: clamp(2.5rem, 6vh, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.82rem;
    color: var(--color-muted);
    letter-spacing: 0.03em;
  }

  @media (min-width: 780px) {
    .footer__inner {
      grid-template-columns: 1.5fr 1fr 1.2fr;
      gap: 3rem;
    }
  }
</style>
