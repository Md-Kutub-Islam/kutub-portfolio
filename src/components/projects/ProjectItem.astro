---
import type { Project } from '@data/projects';
import { has } from '@data/site';
import RevealText from '@components/ui/RevealText.astro';
import MagneticButton from '@components/ui/MagneticButton.astro';
import Arrow from '@components/ui/Arrow.astro';
import ProjectPreview from './ProjectPreview.astro';

interface Props {
  project: Project;
  i: number;
  total: number;
}
const { project, i, total } = Astro.props;
const {
  slug,
  index,
  title,
  subtitle,
  summary,
  role,
  context,
  year,
  status,
  features,
  stack,
  liveUrl,
  repoUrl,
  accentPreview,
  kind,
  company,
  nda,
  metric,
} = project;

const detailHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/projects/${slug}`;
const topFeatures = features.slice(0, 4);
const topStack = stack.slice(0, 6);
const moreStack = stack.length - topStack.length;
---

<article
  class="pcard"
  id={`project-${slug}`}
  style={`--i:${i}; --total:${total}`}
>
  <div class="wrap pcard__inner">
    <div class="pcard__text">
      <div class="pcard__topline">
        <span class="pcard__meta">
          <span class="metanum pcard__idx" aria-hidden="true">{index}</span>
          <i aria-hidden="true">·</i>
          <span>{year}</span>
          <i aria-hidden="true">·</i>
          <span class="pcard__status" data-status={status}>{status}</span>
        </span>
        <span class:list={['pcard__kind', kind === 'personal' ? 'is-personal' : 'is-pro']}>
          <span class="pcard__kind-dot" aria-hidden="true"></span>
          {kind === 'personal'
            ? 'Personal product'
            : `${company ?? 'Wiseboxs'} · Professional work`}
        </span>
      </div>

      <a
        href={detailHref}
        class="pcard__titlelink"
        data-cursor="view"
        data-cursor-label={`View ${title}`}
        aria-label={`View project: ${title}`}
      >
        <RevealText as="h3" lines={[title]} class="pcard__title display" />
      </a>

      <p class="pcard__subtitle" data-reveal style="--reveal-delay:60ms">{subtitle}</p>
      <p class="pcard__summary" data-reveal style="--reveal-delay:110ms">{summary}</p>

      {metric && (
        <div class="pcard__metric" data-reveal style="--reveal-delay:150ms">
          <span class="pcard__metric-nums">
            <span class="pcard__metric-from">{metric.from}</span>
            <span class="pcard__metric-arrow" aria-hidden="true"><Arrow dir="down" size={22} /></span>
            <span class="pcard__metric-to">{metric.to}</span>
          </span>
          <span class="pcard__metric-label">{metric.label}</span>
        </div>
      )}

      <ul class="pcard__features" data-reveal style="--reveal-delay:160ms">
        {topFeatures.map((f) => <li>{f}</li>)}
      </ul>

      <div class="pcard__foot" data-reveal style="--reveal-delay:210ms">
        <ul class="pcard__stack" aria-label="Tech stack">
          {topStack.map((s) => <li>{s}</li>)}
          {moreStack > 0 && <li class="pcard__stack-more">+{moreStack}</li>}
        </ul>

        <div class="pcard__cta">
          <MagneticButton href={detailHref} label="View project" arrow="up-right" cursorView />
          {has(liveUrl) && (
            <a class="link pcard__ext" href={liveUrl} target="_blank" rel="noopener noreferrer">
              Live <Arrow dir="up-right" size={15} />
            </a>
          )}
          {has(repoUrl) && (
            <a class="link pcard__ext" href={repoUrl} target="_blank" rel="noopener noreferrer">
              Code <Arrow dir="up-right" size={15} />
            </a>
          )}
        </div>
      </div>

      {context && (
        <span class="pcard__context">
          {context} · {role}
          {nda && <span class="pcard__nda">Under NDA</span>}
        </span>
      )}
    </div>

    <a
      href={detailHref}
      class="pcard__visual"
      data-reveal="clip"
      style="--reveal-delay:140ms"
      data-cursor="view"
      data-cursor-label={`View ${title}`}
      aria-label={`View project: ${title}`}
      tabindex="-1"
      transition:name={`pv-${slug}`}
    >
      <ProjectPreview type={accentPreview} class="pcard__pv" />
      <span class="pcard__badge" aria-hidden="true">
        <Arrow dir="up-right" size={20} />
      </span>
    </a>
  </div>
</article>

<style>
  .pcard {
    position: relative;
    background: var(--color-bg);
    border-top: 1px solid var(--color-line);
    padding-block: clamp(3rem, 7vh, 6rem);
  }
  .pcard__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .pcard__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-bottom: 1.4rem;
  }
  .pcard__idx {
    color: var(--color-muted);
    font-size: 0.95rem;
  }
  .pcard__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.82rem;
    letter-spacing: 0.05em;
    color: var(--color-fg-dim);
  }
  .pcard__meta i {
    color: var(--color-faint);
  }
  .pcard__status[data-status='Live'] {
    color: var(--color-accent);
  }

  .pcard__titlelink {
    display: inline-block;
  }
  .pcard__title {
    font-size: clamp(2.6rem, 8vw, 6.5rem);
    letter-spacing: -0.045em;
    line-height: 0.92;
  }
  .pcard__titlelink:hover .pcard__title,
  .pcard__titlelink:focus-visible .pcard__title {
    color: var(--color-fg);
  }

  .pcard__subtitle {
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    color: var(--color-fg);
    letter-spacing: -0.01em;
  }
  .pcard__summary {
    margin-top: 0.9rem;
    max-width: 52ch;
    color: var(--color-fg-dim);
    font-size: clamp(0.98rem, 1.4vw, 1.08rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .pcard__features {
    margin-top: 1.6rem;
    display: grid;
    gap: 0.55rem;
    max-width: 52ch;
  }
  .pcard__features li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.92rem;
    color: var(--color-fg-dim);
  }
  .pcard__features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    border: 1px solid var(--color-muted);
  }

  .pcard__foot {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }
  .pcard__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pcard__stack li {
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.34rem 0.8rem;
    font-size: 0.78rem;
    color: var(--color-fg-dim);
    font-variant-numeric: tabular-nums;
  }
  .pcard__stack-more {
    color: var(--color-muted) !important;
  }

  .pcard__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
  }
  .pcard__ext {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--color-fg);
  }

  .pcard__context {
    display: block;
    margin-top: 1.6rem;
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }
  .pcard__nda {
    display: inline-block;
    margin-left: 0.6rem;
    padding: 0.14rem 0.5rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-fg-dim);
    vertical-align: middle;
  }

  /* Personal vs. professional badge -------------------------------------- */
  .pcard__kind {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    line-height: 1;
    white-space: nowrap;
  }
  .pcard__kind-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    flex: none;
  }
  .pcard__kind.is-personal {
    color: var(--color-fg);
    border-color: color-mix(in oklab, var(--color-accent) 45%, transparent);
    background: color-mix(in oklab, var(--color-accent) 8%, transparent);
  }
  .pcard__kind.is-personal .pcard__kind-dot {
    background: var(--color-accent);
  }
  .pcard__kind.is-pro {
    color: var(--color-fg-dim);
    background: color-mix(in oklab, var(--color-fg) 3%, transparent);
  }
  .pcard__kind.is-pro .pcard__kind-dot {
    background: var(--color-muted);
  }

  /* Headline metric (e.g. accessibility / performance before → after) ---- */
  .pcard__metric {
    margin-top: 1.6rem;
    display: inline-flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem 1.4rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 16px;
    background: color-mix(in oklab, var(--color-accent) 4%, transparent);
  }
  .pcard__metric-nums {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    line-height: 0.9;
  }
  .pcard__metric-from {
    font-size: clamp(1.1rem, 2.4vw, 1.6rem);
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: line-through;
    text-decoration-color: color-mix(in oklab, var(--color-muted) 55%, transparent);
  }
  .pcard__metric-arrow {
    display: grid;
    place-items: center;
    color: var(--color-fg-dim);
  }
  .pcard__metric-to {
    font-size: clamp(2.6rem, 6vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--color-accent);
  }
  .pcard__metric-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-fg-dim);
  }

  /* Visual ---------------------------------------------------------------- */
  .pcard__visual {
    position: relative;
    display: block;
    border-radius: var(--radius-card);
  }
  .pcard__pv {
    transition: transform 0.6s var(--ease-out);
  }
  .pcard__badge {
    position: absolute;
    right: clamp(0.8rem, 2vw, 1.4rem);
    top: clamp(0.8rem, 2vw, 1.4rem);
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--color-fg);
    color: var(--color-bg);
    opacity: 0;
    transform: scale(0.85);
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .pcard__visual:hover .pcard__pv {
      transform: scale(1.015);
    }
    .pcard__visual:hover .pcard__badge {
      opacity: 1;
      transform: scale(1);
    }
  }
  .pcard__visual:focus-visible .pcard__badge {
    opacity: 1;
    transform: scale(1);
  }

  /* Desktop: sticky stacking deck ----------------------------------------- */
  @media (min-width: 1024px) {
    .pcard {
      position: sticky;
      top: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      border-radius: var(--radius-card) var(--radius-card) 0 0;
      box-shadow: 0 -32px 60px -30px rgba(0, 0, 0, 0.85);
    }
    .pcard:first-child {
      box-shadow: none;
    }
    .pcard__inner {
      grid-template-columns: 1fr 1fr;
      width: 100%;
    }
    /* Alternate visual side for rhythm */
    .pcard:nth-child(even) .pcard__text {
      order: 2;
    }
  }

  @media (max-width: 1023.98px) {
    .pcard__visual {
      margin-top: 2.5rem;
    }
    .pcard:nth-child(even) .pcard__inner {
      display: flex;
      flex-direction: column;
    }
  }
</style>
